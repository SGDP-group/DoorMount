# Configuration Template
# Copy this file and update with your actual values

# WiFi Settings
WIFI_SSID="YOUR_NETWORK_NAME"
WIFI_PASSWORD="YOUR_NETWORK_PASSWORD"

# LED Pin Configuration (GPIO pins)
# These match the ones defined in esp32_led_controller.ino
RED_PIN=25
GREEN_PIN=26
BLUE_PIN=27

# PWM Settings
PWM_FREQUENCY=5000
PWM_RESOLUTION=8

# Server Settings
WEB_SERVER_PORT=80

# Device Name (for identification)
DEVICE_NAME="DoorMount LED"

# Color Presets (RGB values - 0-255)
COLOR_RED="255,0,0"
COLOR_GREEN="0,255,0"
COLOR_BLUE="0,0,255"
COLOR_YELLOW="255,255,0"
COLOR_WHITE="255,255,255"
COLOR_Off="0,0,0"
